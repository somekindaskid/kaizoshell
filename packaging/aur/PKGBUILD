# Packaging template. Set license and verified source hash before AUR submission.
pkgname=kaizo-shell
pkgver=0.2.0_alpha.1
pkgrel=1
pkgdesc='Modular Quickshell desktop shell for Hyprland'
arch=('x86_64' 'aarch64')
url='https://github.com/somekindaskid/kaizoshell'
license=('custom')
depends=('quickshell' 'hyprland' 'pipewire' 'wireplumber' 'xdg-utils')
makedepends=('go')
optdepends=('imagemagick: wallpaper colours' 'cliphist: clipboard history' 'wl-clipboard: clipboard support' 'hyprlock: screen lock' 'networkmanager: Wi-Fi' 'bluez-utils: Bluetooth' 'brightnessctl: brightness')
source=("$pkgname-source.tar.gz::${url}/releases/download/v0.2.0-alpha.1/kaizo-shell-source.tar.gz")
sha256sums=('REPLACE_WITH_VERIFIED_SOURCE_SHA256')
build() {
  cd kaizo-shell
  CGO_ENABLED=0 go build -trimpath -buildmode=pie -o kaizo .
}
check() {
  cd kaizo-shell
  go test ./...
}
package() {
  cd kaizo-shell
  install -Dm755 kaizo "$pkgdir/usr/bin/kaizo"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
